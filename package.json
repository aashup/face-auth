{
  "name": "react-native-offline-face-auth",
  "version": "0.1.0",
  "description": "Offline facial recognition + liveness detection for React Native field-personnel attendance. Fully on-device, open-source models, AWS sync-and-purge.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "models",
    "react-native-offline-face-auth.podspec",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "face-recognition",
    "liveness",
    "anti-spoofing",
    "offline",
    "attendance",
    "biometrics",
    "tflite"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "@react-native-community/netinfo": ">=11.0.0",
    "axios": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-fast-tflite": ">=1.3.0",
    "react-native-keychain": ">=8.1.0",
    "react-native-vision-camera": ">=4.0.0",
    "react-native-worklets-core": ">=1.3.0",
    "vision-camera-resize-plugin": ">=3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.75.5",
    "react-native-builder-bob": "^0.30.0",
    "react-native-vision-camera": "^4.7.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "react-native-svg": "^15.15.5"
  }
}
